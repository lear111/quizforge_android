{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "areas"
  ],
  "properties": {
    "areas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "formatVersion",
          "id",
          "width",
          "height",
          "strokes"
        ],
        "properties": {
          "type": {
            "const": "qf-answer-area"
          },
          "formatVersion": {
            "const": 1
          },
          "id": {
            "type": "string"
          },
          "width": {
            "const": 760
          },
          "height": {
            "type": "integer",
            "minimum": 120,
            "maximum": 3200
          },
          "text": {
            "type": "string",
            "maxLength": 20000
          },
          "inkSource": {
            "const": "draft"
          },
          "anchor": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              }
            }
          },
          "strokes": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "object"
            }
          },
          "snapshot": {
            "type": "object",
            "required": [
              "type",
              "attrs"
            ],
            "properties": {
              "type": {
                "const": "image"
              },
              "attrs": {
                "type": "object",
                "required": [
                  "assetId"
                ],
                "properties": {
                  "assetId": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            }
          },
          "images": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "id",
                "attrs",
                "x",
                "y",
                "width",
                "height"
              ],
              "properties": {
                "type": {
                  "const": "image"
                },
                "id": {
                  "type": "string"
                },
                "attrs": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "assetId"
                  ],
                  "properties": {
                    "assetId": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  }
                },
                "x": {
                  "type": "number",
                  "minimum": 0
                },
                "y": {
                  "type": "number",
                  "minimum": 0
                },
                "width": {
                  "type": "number",
                  "minimum": 1
                },
                "height": {
                  "type": "number",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
